{
  "state_dir": "/var/lib/peri-cloud",
  "listen": "127.0.0.1:47671",
  "public_origin": "http://127.0.0.1:47671",
  "bootstrap_env": "PERI_BOOTSTRAP_TOKEN",
  "model": {
    "api_base": "https://api.example.com/v1",
    "api_key_env": "PERI_MODEL_API_KEY",
    "model": "your-model-name",
    "context_window": 131072,
    "max_tokens": 8192,
    "thinking_enabled": false,
    "supports_thinking_content": false
  },
  "model_providers": [],
  "limits": {
    "max_active_turns": 4,
    "max_active_per_user": 1,
    "daily_turns": 200,
    "daily_model_requests": 1000,
    "max_turn_seconds": 600,
    "max_prompt_bytes": 65536,
    "max_user_data_bytes": 8192
  },
  "devices": [],
  "local_instance": {
    "name": "服务器本地",
    "workspace": "/var/lib/peri-cloud/workspace"
  },
  "qq": {
    "instance_id": "qq-main",
    "app_id_env": "PERI_QQ_APP_ID",
    "client_secret_env": "PERI_QQ_CLIENT_SECRET",
    "transport": "websocket",
    "interaction": { "kind": "native" }
  },
  "max_iterations": 32
}
